# Admin console build settings (Vite). Copy to admin/.env.local for local
# development; on Vercel set them as project environment variables (they are
# read at BUILD time and end up in the public JavaScript bundle).
#
# PUBLIC values only: the Supabase project URL and its anon / publishable key.
# Never the service-role / secret key: the app refuses one (auth/supabaseClient.ts).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
