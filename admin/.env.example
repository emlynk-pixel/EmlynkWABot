# Admin console build settings (Vite).
#
# Local development: copy this file to admin/.env.local (git-ignored) and fill in
# the two values from the Supabase dashboard (Project Settings > API).
# Deployed builds (e.g. Vercel): set both as project environment variables;
# Vite reads them at BUILD time and they end up in the public JavaScript bundle.
#
# PUBLIC values only: the Supabase project URL and its anon / publishable key.
# Never the service-role / secret key: the app refuses one (auth/supabaseClient.ts).
# Without them the sign-in page reports that sign-in is not configured.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
