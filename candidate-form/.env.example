# Candidate Extra Details form (Vercel Project B). Copy to .env.local for
# local development. PUBLIC values only: every VITE_API_* value is embedded in
# the browser bundle, and no other variable is (vite.config.ts envPrefix).
#
# The backend's public origin (Vercel Project A), no trailing slash.
# Local development: http://localhost:3000 (the backend must then allow
# http://localhost:5174 as the form's origin).
VITE_API_BASE_URL=

# Optional: comma-separated administrator mobile numbers displayed in the
# "Contact Admin" section on the form's access-failure screens.
# Example: 0771234567,0719876543
# Public contact numbers, not secrets. Leave empty to omit the numbers section.
VITE_API_ADMIN_MOBILE_NUMBERS=
