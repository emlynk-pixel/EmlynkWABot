# Submission Worker only.
# Used by the Preview Cloud Run worker.
# The API/webhook runs on Vercel; PostgreSQL is the queue.

FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
WORKDIR /app

# Prisma generate runs during npm ci.
COPY package.json package-lock.json ./
COPY prisma/schema.prisma ./prisma/schema.prisma
RUN npm ci --omit=dev && npm cache clean --force

# Runtime files needed by the worker.
COPY prisma/migrations ./prisma/migrations
COPY src ./src
COPY scripts/createAdmin.js scripts/checkDatabaseConnection.js ./scripts/

# Cloud Run uses this port for the health endpoint.
ENV PORT=8080
EXPOSE 8080

USER node

# Worker-only entry point.
CMD ["node", "src/worker.js"]