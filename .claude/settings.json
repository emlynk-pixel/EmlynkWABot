{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Read(.env.example)"
    ],
    "ask": [
      "Bash",
      "Edit",
      "Write"
    ],
    "deny": [
      "Read(.env*)",
      "Read(!.env.example)"
    ]
  }
}
