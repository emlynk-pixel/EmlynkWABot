# Copy to .env and fill in. Never commit .env.
# The server checks these at startup (src/config/env.js) and refuses to
# start if any is missing or malformed.

# Supabase Postgres (backend role). postgresql://...
DATABASE_URL=

# Optional. Caps the pg.Pool size per app instance (src/config/prisma.js).
# Default 3. Keep this low on Vercel: every function instance gets its own
# pool on top of Supabase's own Supavisor session pooler, so a high value
# here multiplies with concurrent instances rather than helping throughput.
DATABASE_POOL_MAX=

# Supabase project URL and service-role key (backend only, never in a browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket holding temporary/, clients/ and pending/.
SUPABASE_BUCKET=

# At least 32 random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Meta / WhatsApp Cloud API
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# e.g. v21.0
WHATSAPP_API_VERSION=

# OCR service (ocr-worker/). Locally: http://127.0.0.1:8080 (npm run ocr:start).
# Production: the Cloud Run service URL, https://....run.app — requests then
# carry a Google identity token from Application Default Credentials: a
# service account with roles/run.invoker on the service, e.g. via
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json when not running on
# Google Cloud. Never commit key files. See ocr-worker/README.md.
OCR_SERVICE_URL=

# Email (required for admin invitations and password-reset emails)
# Use an SMTP relay, Gmail App Password, or a transactional email service.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# 16-character Google App Password (no spaces) — generate at:
# https://myaccount.google.com/apppasswords
SMTP_PASS=your-16-char-app-password
# Display name and address for outbound system emails.
EMAIL_FROM=Emlynk Admin <your-email@gmail.com>

# Base URL of this server, used in invitation and password-reset email links.
# Must not have a trailing slash. Example: https://admin.example.com
APP_BASE_URL=https://your-domain.com

# Optional
# PORT=3000
# Only behind a known reverse proxy: the exact number of proxy hops (e.g. 1).
# Leave unset otherwise; never "true". On Vercel: 1 (Vercel sets
# X-Forwarded-For to the client's IP and overwrites what the client sent;
# see Docs/19, Step 5D).
# TRUST_PROXY_HOPS=
# Documents every client must have (comma-separated; must include PASSPORT).
# Allowed: PASSPORT, POLICE_SLIP, POLICE_REPORT, MEDICAL. Default:
# REQUIRED_DOCUMENT_TYPES=PASSPORT,POLICE_REPORT,MEDICAL
