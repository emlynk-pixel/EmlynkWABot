# Copy to .env and fill in. Never commit .env.
# The server checks these at startup (src/config/env.js) and refuses to
# start if any is missing or malformed.

# Supabase Postgres (backend role). postgresql://...
DATABASE_URL=

# Supabase project URL and service-role key (backend only, never in a browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket holding temporary/, clients/ and pending/.
SUPABASE_BUCKET=

# At least 32 random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Meta / WhatsApp Cloud API
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# e.g. v21.0
WHATSAPP_API_VERSION=

# Optional
# PORT=3000
# Only behind a known reverse proxy: the exact number of proxy hops (e.g. 1).
# Leave unset otherwise; never "true".
# TRUST_PROXY_HOPS=
