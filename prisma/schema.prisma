// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Application users (staff). Supabase Auth (auth.users) owns the credentials
// and sessions; this row owns the application profile, role and status.
// auth_user_id = auth.users.id (a foreign key to auth.users where that schema
// exists, i.e. on Supabase; see migration 20261009120000_supabase_auth_cutover).
// status: INVITED | ACTIVE | INACTIVE (middleware/requireActiveUser.js).
// role:   ADMIN | MANAGER | ANALYST | REGISTRATION_DESK (middleware/requireRole.js).
model User {
  adminId     String             @id @map("admin_id")
  authUserId  String             @unique @map("auth_user_id") @db.Uuid
  name        String
  email       String             @unique
  role        String
  status      String             @default("ACTIVE")
  createdDate DateTime           @default(now()) @map("created_date")
  updatedDate DateTime           @updatedAt @map("updated_date")
  auditLogs   AuditLog[]
  callLogs    CandidateCallLog[]

  @@map("user")
}

// Review actions taken by admins (Phase 10). Append-only: rows are never
// updated or deleted (a database trigger rejects both). The reviewed item is
// kept as plain IDs, without foreign keys, so the history outlives the
// temporary_data / documents rows it describes (Remove from Review deletes
// the submission's row; its entry stays).
model AuditLog {
  auditId             String    @id @map("audit_id")
  adminId             String    @map("admin_id")
  // APPROVE | KEEP_PENDING | REMOVE_FROM_REVIEW
  // | SET_DOCUMENT_TYPE | ASSIGN_CLIENT | SET_POLICE_DATE
  // | RETRY_PROCESSING (H3: previous_value holds the failure code)
  action              String
  temporaryId         String?   @map("temporary_id")
  documentId          String?   @map("document_id")
  passportId          String?   @map("passport_id")
  previousStatus      String    @map("previous_status")
  newStatus           String    @map("new_status")
  reason              String?
  // Approval of a police slip: the submitted date the admin entered or confirmed.
  policeSubmittedDate DateTime? @map("police_submitted_date") @db.Date
  // Remove from Review deletes the submission's row, so the entry keeps
  // what was removed: its document type and file checksum.
  documentType        String?   @map("document_type")
  fileSha256          String?   @map("file_sha256") @db.Char(64)
  // Corrections: the value before and after (document type, passport ID
  // or police slip date as YYYY-MM-DD). Null for the other actions.
  previousValue       String?   @map("previous_value")
  newValue            String?   @map("new_value")
  createdDate         DateTime  @default(now()) @map("created_date")

  admin User @relation(fields: [adminId], references: [adminId], onDelete: Restrict)

  @@index([temporaryId, createdDate])
  @@index([documentId, createdDate])
  @@index([adminId, createdDate])
  @@map("audit_logs")
}

//Candidate table (formerly "users"; target architecture: public.candidate).

model Candidate {
  passportId         String          @id @map("passport_id")
  uniqueId           String          @unique @map("unique_id")
  firstName          String          @map("first_name")
  otherName          String?         @map("other_name")
  dateOfBirth        DateTime?       @map("date_of_birth")
  placeOfBirth       String?         @map("place_of_birth")
  passportExpiryDate DateTime?       @map("passport_expiry_date")
  picture            String?
  // A partial unique index on this column (not expressible in Prisma's
  // schema DSL — a WHERE-conditioned unique index) is defined directly in
  // SQL by migration 20261001140000_whatsapp_unique_constraint. Do not add
  // @unique here: that would create a second, unconditional index rather
  // than represent the real constraint. Maintain the real one through a SQL
  // migration, not this field.
  whatsappNumber     String?         @map("whatsapp_number")
  contactNumber      String?         @map("contact_number")
  address            String?
  // Job types: a comma-separated list ("Construction Worker, Caregiver").
  // Older records hold a single value, which reads as a list of one.
  job                String?
  createdDate        DateTime        @default(now()) @map("created_date")
  updatedDate        DateTime        @updatedAt @map("updated_date")
  documents          Document[]
  temporaryData      TemporaryData[]

  // Candidate deployment (candidateService.js). NIC is unique, so the same
  // person can't be registered twice under two passport records.
  nic               String?            @unique
  jobExperience     String?            @map("job_experience")
  // Optional passport details with no earlier column (the passport OCR reads
  // date of birth, place of birth and expiry only). sex: M, F or X.
  nationality       String?
  sex               String?
  passportIssueDate DateTime?          @map("passport_issue_date")
  stages            CandidateStage[]
  callLogs          CandidateCallLog[]

  @@map("candidate")
}

//added document table

model Document {
  documentId         String   @id @map("document_id")
  passportId         String   @map("passport_id")
  documentType       String   @map("document_type")
  originalFilename   String   @map("original_filename")
  storedFilename     String   @map("stored_filename")
  storagePath        String   @map("storage_path")
  mimeType           String?  @map("mime_type")
  fileSize           BigInt?  @map("file_size")
  receivedDate       DateTime @map("received_date")
  processingStatus   String   @map("processing_status")
  verificationStatus String   @map("verification_status")
  ocrConfidence      Decimal? @map("ocr_confidence")
  createdDate        DateTime @default(now()) @map("created_date")
  updatedDate        DateTime @updatedAt @map("updated_date")

  user       Candidate @relation(fields: [passportId], references: [passportId])
  fileSha256 String?   @map("file_sha256") @db.Char(64)

  // Submission (temporary_data row) this file was stored from (Phase 10):
  // its processing summary and review reason explain a REVIEW_REQUIRED
  // document. Null for documents stored before this column existed.
  temporaryId   String?        @map("temporary_id")
  temporaryData TemporaryData? @relation(fields: [temporaryId], references: [temporaryId], onDelete: SetNull)

  // Police slips only (Phase 10, Checkpoint 5): the submitted date that
  // starts the 21-day wait for the final police report. Read by OCR or
  // entered by an admin when approving the slip; null otherwise.
  policeSubmittedDate DateTime? @map("police_submitted_date") @db.Date

  // Which form of the document an admin uploaded (candidateService.js):
  // police reports SL_VERIFIED / ROMANIA / SL_NORMAL, affidavits ENGLISH /
  // SINHALA. Null for every other document.
  documentVariant String? @map("document_variant")

  @@unique([passportId, fileSha256])
  @@index([fileSha256])
  @@index([temporaryId])
  @@map("documents")
}

//added temporary table

model TemporaryData {
  temporaryId          String   @id @map("temporary_id")
  passportId           String?  @map("passport_id")
  uniqueId             String?  @map("unique_id")
  whatsappNumber       String   @map("whatsapp_number")
  documentType         String   @map("document_type")
  temporaryStoragePath String   @map("temporary_storage_path")
  processingStatus     String   @map("processing_status")
  createdDate          DateTime @default(now()) @map("created_date")

  user               Candidate? @relation(fields: [passportId], references: [passportId])
  fileSha256         String?    @map("file_sha256") @db.Char(64)
  // Exact object path of the copy placed in pending/ (Phase 7), if any.
  pendingStoragePath String?    @map("pending_storage_path")

  // Phase 10 review data, written when processing finishes (or fails).
  // processing_summary: the PII-free processing summary (confidences, band,
  // flags, identity status/notes, field names, placement, failing stage).
  // review_reason: why a person must look at it (see reviewReason.js), or
  // null when no review is needed. Both null for rows processed earlier.
  processingSummary Json?      @map("processing_summary")
  reviewReason      String?    @map("review_reason")
  documents         Document[]

  // M1: asynchronous processing. The row is the durable job: the webhook
  // commits it (status TEMPORARY_STORED) before answering Meta, and the
  // background worker (submissionQueue.js) processes it.
  // message_id: the WhatsApp message ID; unique, so a redelivered message
  // never creates a second submission (also across restarts).
  messageId           String?   @unique @map("message_id")
  // As received on WhatsApp, for processing later (a file name can hold a
  // client's name, so it is never logged).
  originalFilename    String?   @map("original_filename")
  receivedAt          DateTime? @map("received_at")
  // Worker lease: claimed attempts and when the current attempt started.
  processingAttempts  Int       @default(0) @map("processing_attempts")
  processingStartedAt DateTime? @map("processing_started_at")
  // The clients/ or pending/ object path an attempt was about to create,
  // recorded before the copy: a retry after a crash reuses that object
  // instead of making a second copy (placementRecovery.js).
  placementPath       String?   @map("placement_path")

  @@index([whatsappNumber, fileSha256])
  @@index([processingStatus, createdDate])
  @@map("temporary_data")
}

// Rate-limit counters (Phase 12, Step 5C), shared by every app instance
// (several serverless instances on Vercel). Operational state only: one row
// per limiter and client, reused when its window has passed, deleted once
// expired (middleware/postgresRateLimitStore.js). key = "<limiter>:<sha256 of
// the client key>", so no IP address is stored.
// Candidate deployment stages (candidateService.js). One row per candidate
// and stage once anything is saved for it; a missing row is an incomplete
// stage without notes. Stages are independent: any can be completed in any
// order.
model CandidateStage {
  passportId  String    @map("passport_id")
  // TEST_DETAILS | CANDIDATE_DETAILS | DOCUMENT_SUBMISSION | IVS_INTERVIEW
  // | VISA_APPROVAL | FINALIZING_JOB
  stage       String
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  notes       String?
  updatedAt   DateTime  @updatedAt @map("updated_at")
  // TEST_DETAILS only (null on the other stages): the job ID the admin
  // enters, the test's result (PASS or FAIL) and the date the candidate
  // actually sat it. Null until recorded.
  jobId       String?   @map("job_id")
  testResult  String?   @map("test_result")
  testDate    DateTime? @map("test_date") @db.Date

  user Candidate @relation(fields: [passportId], references: [passportId], onDelete: Cascade)

  @@id([passportId, stage])
  @@map("candidate_stages")
}

// Calls made to a candidate, noted by admins (candidateService.js).
model CandidateCallLog {
  callLogId   String   @id @map("call_log_id")
  passportId  String   @map("passport_id")
  adminId     String   @map("admin_id")
  // What the candidate said (a short note).
  note        String
  // When the call took place: the date and time the admin entered, or now.
  createdDate DateTime @default(now()) @map("created_date")

  user  Candidate @relation(fields: [passportId], references: [passportId], onDelete: Cascade)
  admin User      @relation(fields: [adminId], references: [adminId], onDelete: Restrict)

  @@index([passportId, createdDate])
  @@map("candidate_call_logs")
}

model RateLimit {
  key     String   @id
  hits    Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limits")
}

// Google Sheet operational mirror (Docs/GOOGLE_SHEET_CANDIDATE_SYNC_ARCHITECTURE.md,
// Section 8): the durable outbox. A row means "candidate <unique_id> needs to
// be mirrored", never a data snapshot (no PII): the worker re-reads the
// candidate when it processes the row. Rows are written by database triggers
// on candidate, candidate_stages and documents (migration
// 20261006120000_sheet_sync_outbox; repointed from "users" by migration
// 20261008120000_rename_candidate_user_tables), in the same transaction as
// the change.
// A partial unique index (not expressible here, defined in that migration's
// SQL) keeps at most ONE PENDING row per candidate, so changes coalesce. Do not
// add @unique on uniqueId: there may be one PENDING row plus older
// PROCESSING/COMPLETED/FAILED rows for the same candidate.
// status: PENDING | PROCESSING | COMPLETED | FAILED (dead letter).
model SheetSyncQueue {
  queueId          String    @id @default(dbgenerated("(gen_random_uuid())::text")) @map("queue_id")
  uniqueId         String    @map("unique_id")
  status           String    @default("PENDING")
  // Set when the candidate's row was deleted (or its unique ID
  // changed): only then may a missing candidate mark its row inactive.
  candidateDeleted Boolean   @default(false) @map("candidate_deleted")
  // Claims so far (incremented when claimed, so a crash counts too).
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseOwner       String?   @map("lease_owner")
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  // APPENDED | UPDATED | UNCHANGED | MARKED_INACTIVE | NOT_IN_DATABASE
  // | SUPERSEDED | RESOLVED (codes only, never values).
  lastResult       String?   @map("last_result")
  lastErrorClass   String?   @map("last_error_class")
  lastErrorCode    String?   @map("last_error_code")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([uniqueId])
  @@map("sheet_sync_queue")
}

// Durable run requests (Section 8.3): reconciliation (Sync Now, Cloud
// Scheduler) and Test Connection. The Admin API only inserts QUEUED rows; the
// sheet-sync worker claims and executes them. A partial unique index (in the
// migration's SQL) allows at most one QUEUED/RUNNING run per kind.
// kind: RECONCILE | TEST_CONNECTION; triggerSource: ADMIN | SCHEDULER | OPERATOR;
// status: QUEUED | RUNNING | SUCCEEDED | FAILED | SKIPPED.
// summary: counts and codes only, never candidate data.
model SheetSyncRun {
  runId          String    @id @map("run_id")
  kind           String
  triggerSource  String    @map("trigger_source")
  requestedBy    String?   @map("requested_by")
  status         String    @default("QUEUED")
  dryRun         Boolean?  @map("dry_run")
  attempts       Int       @default(0)
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  summary        Json?
  errorClass     String?   @map("error_class")
  errorCode      String?   @map("error_code")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([kind, createdAt])
  @@index([status])
  @@map("sheet_sync_runs")
}

// One row ("sheet-sync", created by the migration): the integration's
// operational state as reported by the sheet-sync worker (the Admin API on
// Vercel has no Google access and reads it from here), and the writer lease
// that keeps a single process writing to the Sheet at a time.
// integrationState: UNKNOWN | OK | CONFIG_ERROR | DATA_INTEGRITY.
model SheetSyncState {
  stateId              String    @id @map("state_id")
  integrationState     String    @default("UNKNOWN") @map("integration_state")
  lastErrorClass       String?   @map("last_error_class")
  lastErrorCode        String?   @map("last_error_code")
  lastErrorAt          DateTime? @map("last_error_at") @db.Timestamptz(3)
  lastSyncSuccessAt    DateTime? @map("last_sync_success_at") @db.Timestamptz(3)
  // ENABLED | DISABLED, as the worker last read SHEET_SYNC_ENABLED.
  writeGate            String?   @map("write_gate")
  configured           Boolean?
  // Last characters of the spreadsheet ID and the tab name: enough to tell
  // which Sheet is targeted, never the full identifier.
  targetHint           String?   @map("target_hint")
  workerHeartbeatAt    DateTime? @map("worker_heartbeat_at") @db.Timestamptz(3)
  writerLeaseOwner     String?   @map("writer_lease_owner")
  writerLeaseExpiresAt DateTime? @map("writer_lease_expires_at") @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("sheet_sync_state")
}
