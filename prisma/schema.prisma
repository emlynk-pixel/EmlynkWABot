// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Application users (staff). Supabase Auth (auth.users) owns the credentials
// and sessions; this row owns the application profile, role and status.
// auth_user_id = auth.users.id (a foreign key to auth.users where that schema
// exists, i.e. on Supabase; see migration 20261009120000_supabase_auth_cutover).
// status: INVITED | ACTIVE | INACTIVE (middleware/requireActiveUser.js).
// role:   ADMIN | MANAGER | ANALYST | REGISTRATION_DESK (middleware/requireRole.js).
model User {
  adminId               String                     @id @map("admin_id")
  authUserId            String                     @unique @map("auth_user_id") @db.Uuid
  name                  String
  email                 String                     @unique
  role                  String
  status                String                     @default("ACTIVE")
  createdDate           DateTime                   @default(now()) @map("created_date")
  updatedDate           DateTime                   @updatedAt @map("updated_date")
  auditLogs             AuditLog[]
  callLogs              CandidateCallLog[]
  // Priority Follow-Ups this user flagged / completed.
  flaggedFollowUps      CallLogFollowUp[]          @relation("FollowUpFlaggedBy")
  completedFollowUps    CallLogFollowUp[]          @relation("FollowUpCompletedBy")
  // Work Allocation: the candidates assigned to this user (an Analyst).
  allocatedCandidates   CandidateAllocation[]
  // Candidate Form share links this user created / revoked, and forms unlocked.
  createdFormLinks      CandidateFormLink[]        @relation("FormLinkCreatedBy")
  revokedFormLinks      CandidateFormLink[]        @relation("FormLinkRevokedBy")
  unlockedFormAccess    CandidateFormAccess[]      @relation("FormAccessUnlockedBy")
  // Manual verification of a candidate's details / documents (candidate_verification).
  verifiedDetails       CandidateVerification[]    @relation("DetailsVerifiedBy")
  verifiedDocuments     CandidateVerification[]    @relation("DocumentsVerifiedBy")
  // Job Management.
  createdJobs           Job[]                      @relation("JobCreatedBy")
  assignedJobCandidates JobCandidate[]             @relation("JobCandidateAssignedBy")
  // Candidate Form values this user confirmed or rejected, field by field.
  formFieldReviews      CandidateFormFieldReview[] @relation("FormFieldReviewedBy")

  @@map("user")
}

// Review actions taken by admins (Phase 10). Append-only: rows are never
// updated or deleted (a database trigger rejects both). The reviewed item is
// kept as plain IDs, without foreign keys, so the history outlives the
// temporary_data / documents rows it describes (Remove from Review deletes
// the submission's row; its entry stays).
model AuditLog {
  auditId             String    @id @map("audit_id")
  adminId             String    @map("admin_id")
  // APPROVE | KEEP_PENDING | REMOVE_FROM_REVIEW
  // | SET_DOCUMENT_TYPE | ASSIGN_CLIENT | SET_POLICE_DATE
  // | RETRY_PROCESSING (H3: previous_value holds the failure code)
  action              String
  temporaryId         String?   @map("temporary_id")
  documentId          String?   @map("document_id")
  passportId          String?   @map("passport_id")
  previousStatus      String    @map("previous_status")
  newStatus           String    @map("new_status")
  reason              String?
  // Approval of a police slip: the submitted date the admin entered or confirmed.
  policeSubmittedDate DateTime? @map("police_submitted_date") @db.Date
  // Remove from Review deletes the submission's row, so the entry keeps
  // what was removed: its document type and file checksum.
  documentType        String?   @map("document_type")
  fileSha256          String?   @map("file_sha256") @db.Char(64)
  // Corrections: the value before and after (document type, passport ID
  // or police slip date as YYYY-MM-DD). Null for the other actions.
  previousValue       String?   @map("previous_value")
  newValue            String?   @map("new_value")
  createdDate         DateTime  @default(now()) @map("created_date")

  admin User @relation(fields: [adminId], references: [adminId], onDelete: Restrict)

  @@index([temporaryId, createdDate])
  @@index([documentId, createdDate])
  @@index([adminId, createdDate])
  @@map("audit_logs")
}

//Candidate table (formerly "users"; target architecture: public.candidate).

model Candidate {
  passportId         String          @id @map("passport_id")
  uniqueId           String          @unique @map("unique_id")
  firstName          String          @map("first_name")
  otherName          String?         @map("other_name")
  dateOfBirth        DateTime?       @map("date_of_birth")
  placeOfBirth       String?         @map("place_of_birth")
  passportExpiryDate DateTime?       @map("passport_expiry_date")
  picture            String?
  // A partial unique index on this column (not expressible in Prisma's
  // schema DSL — a WHERE-conditioned unique index) is defined directly in
  // SQL by migration 20261001140000_whatsapp_unique_constraint. Do not add
  // @unique here: that would create a second, unconditional index rather
  // than represent the real constraint. Maintain the real one through a SQL
  // migration, not this field.
  whatsappNumber     String?         @map("whatsapp_number")
  contactNumber      String?         @map("contact_number")
  address            String?
  // Job types: a comma-separated list ("Construction Worker, Caregiver").
  // Older records hold a single value, which reads as a list of one.
  job                String?
  createdDate        DateTime        @default(now()) @map("created_date")
  updatedDate        DateTime        @updatedAt @map("updated_date")
  documents          Document[]
  temporaryData      TemporaryData[]

  // Candidate deployment (candidateService.js). NIC is unique, so the same
  // person can't be registered twice under two passport records.
  nic               String?                       @unique
  jobExperience     String?                       @map("job_experience")
  // Optional passport details with no earlier column (the passport OCR reads
  // date of birth, place of birth and expiry only). sex: M, F or X.
  nationality       String?
  sex               String?
  passportIssueDate DateTime?                     @map("passport_issue_date")
  stages            CandidateStage[]
  callLogs          CandidateCallLog[]
  // Optional extra details (Admin > Candidates > Additional Details). A
  // relation only: the candidate table has no column for it.
  additionalDetails CandidateAdditionalDetails?
  // Work Allocation: the Analyst the candidate is assigned to (no row:
  // unallocated). A relation only, like additionalDetails.
  allocation        CandidateAllocation?
  // Candidate Form (public): share links, the lock, the submitted answers and
  // the prefill snapshot. Relations only: no candidate column changes.
  formLinks         CandidateFormLink[]
  formAccess        CandidateFormAccess?
  formResponse      CandidateFormResponse?
  formSnapshot      CandidateFormPrefillSnapshot?
  // Job Management: every job the candidate was assigned to (history). The
  // row with is_active = true is the current PROCESSING job. Relation only.
  jobAssignments    JobCandidate[]
  // Staff decisions on candidate-submitted form values (CONFIRMED / REJECTED); no row = pending.
  formFieldReviews  CandidateFormFieldReview[]
  // Explicit details / documents verification (a relation only).
  verification      CandidateVerification?

  @@map("candidate")
}

// Candidate Form share link (candidateFormShareService.js). Only a SHA-256 of
// the link secret is stored. kind SINGLE = one candidate; a job-group kind can
// be added later (passport_id is nullable for that reason).
// Migration 20261017120000_candidate_form_share_and_response.
model CandidateFormLink {
  linkId         String    @id @map("link_id")
  kind           String    @default("SINGLE")
  passportId     String?   @map("passport_id")
  // JOB_GROUP: the immutable job.id the link is bound to (passport_id NULL).
  jobId          String?   @map("job_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  createdById    String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  revokedById    String?   @map("revoked_by")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastVerifiedAt DateTime? @map("last_verified_at")

  candidate       Candidate?                     @relation(fields: [passportId], references: [passportId], onDelete: Cascade, onUpdate: Cascade)
  job             Job?                           @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User                           @relation("FormLinkCreatedBy", fields: [createdById], references: [adminId], onDelete: Restrict, onUpdate: Cascade)
  revokedBy       User?                          @relation("FormLinkRevokedBy", fields: [revokedById], references: [adminId], onDelete: Restrict, onUpdate: Cascade)
  unlockedAccess  CandidateFormAccess[]          @relation("AccessUnlockedViaLink")
  submittedAccess CandidateFormAccess[]          @relation("AccessSubmittedViaLink")
  responses       CandidateFormResponse[]
  snapshots       CandidateFormPrefillSnapshot[]

  @@index([passportId])
  @@index([jobId])
  @@index([createdById])
  @@map("candidate_form_link")
}

// The lock: LOCKED (no row) -> UNLOCKED (a link was created) -> SUBMITTED
// (terminal; a trigger refuses any later change).
model CandidateFormAccess {
  passportId         String    @id @map("passport_id")
  status             String    @default("LOCKED")
  version            Int       @default(0)
  unlockedAt         DateTime? @map("unlocked_at")
  unlockedById       String?   @map("unlocked_by")
  unlockedViaLinkId  String?   @map("unlocked_via_link_id")
  submittedAt        DateTime? @map("submitted_at")
  submittedViaLinkId String?   @map("submitted_via_link_id")
  submitKey          String?   @map("submit_key")
  updatedAt          DateTime  @default(now()) @map("updated_at")

  candidate        Candidate          @relation(fields: [passportId], references: [passportId], onDelete: Cascade, onUpdate: Cascade)
  unlockedBy       User?              @relation("FormAccessUnlockedBy", fields: [unlockedById], references: [adminId], onDelete: Restrict, onUpdate: Cascade)
  unlockedViaLink  CandidateFormLink? @relation("AccessUnlockedViaLink", fields: [unlockedViaLinkId], references: [linkId], onDelete: SetNull, onUpdate: Cascade)
  submittedViaLink CandidateFormLink? @relation("AccessSubmittedViaLink", fields: [submittedViaLinkId], references: [linkId], onDelete: SetNull, onUpdate: Cascade)

  @@index([unlockedViaLinkId])
  @@index([submittedViaLinkId])
  @@map("candidate_form_access")
}

// The answers the candidate submitted (every field nullable). Written once;
// a trigger refuses any later change. The main candidate tables are never
// written by the public form.
model CandidateFormResponse {
  passportId           String    @id @map("passport_id")
  fullName             String?   @map("full_name")
  surname              String?   @map("surname")
  otherNames           String?   @map("other_names")
  nic                  String?   @map("nic")
  sex                  String?   @map("sex")
  civilStatus          String?   @map("civil_status")
  birthDate            DateTime? @map("birth_date") @db.Date
  birthPlace           String?   @map("birth_place")
  address              String?   @map("address")
  city                 String?   @map("city")
  district             String?   @map("district")
  dsDivision           String?   @map("ds_division")
  gnDivision           String?   @map("gn_division")
  alternativePhone     String?   @map("alternative_phone")
  email                String?   @map("email")
  passportIssueDate    DateTime? @map("passport_issue_date") @db.Date
  passportExpiryDate   DateTime? @map("passport_expiry_date") @db.Date
  jobCategory          String?   @map("job_category")
  jobCategoryOther     String?   @map("job_category_other")
  experience           String?   @map("experience")
  otherSkills1         String?   @map("other_skills_1")
  otherSkills2         String?   @map("other_skills_2")
  englishKnowledge     String?   @map("english_knowledge")
  shirtSize            String?   @map("shirt_size")
  waistSize            String?   @map("waist_size")
  shoeSize             String?   @map("shoe_size")
  fatherName           String?   @map("father_name")
  fatherSurname        String?   @map("father_surname")
  fatherPassportNumber String?   @map("father_passport_number")
  fatherBirthDate      DateTime? @map("father_birth_date") @db.Date
  motherName           String?   @map("mother_name")
  motherSurname        String?   @map("mother_surname")
  motherPassportNumber String?   @map("mother_passport_number")
  motherBirthDate      DateTime? @map("mother_birth_date") @db.Date
  spouseName           String?   @map("spouse_name")
  spouseSurname        String?   @map("spouse_surname")
  spousePassportNumber String?   @map("spouse_passport_number")
  spouseBirthDate      DateTime? @map("spouse_birth_date") @db.Date
  child1Name           String?   @map("child_1_name")
  child2Name           String?   @map("child_2_name")
  child3Name           String?   @map("child_3_name")
  guardianName         String?   @map("guardian_name")
  guardianRelationship String?   @map("guardian_relationship")
  guardianNic          String?   @map("guardian_nic")
  guardianBirthDate    DateTime? @map("guardian_birth_date") @db.Date
  guardianPhone        String?   @map("guardian_phone")
  guardianAddress      String?   @map("guardian_address")
  submittedAt          DateTime  @default(now()) @map("submitted_at")
  submittedViaLinkId   String?   @map("submitted_via_link_id")

  candidate        Candidate          @relation(fields: [passportId], references: [passportId], onDelete: Cascade, onUpdate: Cascade)
  submittedViaLink CandidateFormLink? @relation(fields: [submittedViaLinkId], references: [linkId], onDelete: SetNull, onUpdate: Cascade)

  @@index([submittedViaLinkId])
  @@map("candidate_form_response")
}

// Per-field staff decision on a candidate-submitted value (candidateFormFieldConfirmService.js).
// PENDING is the absence of a row; a decision is final (trigger). The submitted answers stay
// untouched in candidate_form_response. Migration 20261018140000_candidate_form_field_review.
model CandidateFormFieldReview {
  passportId     String   @map("passport_id")
  fieldKey       String   @map("field_key")
  // CONFIRMED | REJECTED
  status         String
  submittedValue String?  @map("submitted_value")
  currentValue   String?  @map("current_value")
  reviewedById   String   @map("reviewed_by")
  reviewedAt     DateTime @default(now()) @map("reviewed_at")

  candidate  Candidate @relation(fields: [passportId], references: [passportId], onDelete: Cascade, onUpdate: Cascade)
  reviewedBy User      @relation("FormFieldReviewedBy", fields: [reviewedById], references: [adminId], onDelete: Restrict, onUpdate: Cascade)

  @@id([passportId, fieldKey])
  @@index([reviewedById])
  @@map("candidate_form_field_review")
}

// What the form was prefilled with from the existing records, taken once at
// the first verified visit (the original values, for comparison). Never changed.
model CandidateFormPrefillSnapshot {
  passportId           String    @id @map("passport_id")
  fullName             String?   @map("full_name")
  surname              String?   @map("surname")
  otherNames           String?   @map("other_names")
  nic                  String?   @map("nic")
  sex                  String?   @map("sex")
  civilStatus          String?   @map("civil_status")
  birthDate            DateTime? @map("birth_date") @db.Date
  birthPlace           String?   @map("birth_place")
  address              String?   @map("address")
  city                 String?   @map("city")
  district             String?   @map("district")
  dsDivision           String?   @map("ds_division")
  gnDivision           String?   @map("gn_division")
  alternativePhone     String?   @map("alternative_phone")
  email                String?   @map("email")
  passportIssueDate    DateTime? @map("passport_issue_date") @db.Date
  passportExpiryDate   DateTime? @map("passport_expiry_date") @db.Date
  jobCategory          String?   @map("job_category")
  jobCategoryOther     String?   @map("job_category_other")
  experience           String?   @map("experience")
  otherSkills1         String?   @map("other_skills_1")
  otherSkills2         String?   @map("other_skills_2")
  englishKnowledge     String?   @map("english_knowledge")
  shirtSize            String?   @map("shirt_size")
  waistSize            String?   @map("waist_size")
  shoeSize             String?   @map("shoe_size")
  fatherName           String?   @map("father_name")
  fatherSurname        String?   @map("father_surname")
  fatherPassportNumber String?   @map("father_passport_number")
  fatherBirthDate      DateTime? @map("father_birth_date") @db.Date
  motherName           String?   @map("mother_name")
  motherSurname        String?   @map("mother_surname")
  motherPassportNumber String?   @map("mother_passport_number")
  motherBirthDate      DateTime? @map("mother_birth_date") @db.Date
  spouseName           String?   @map("spouse_name")
  spouseSurname        String?   @map("spouse_surname")
  spousePassportNumber String?   @map("spouse_passport_number")
  spouseBirthDate      DateTime? @map("spouse_birth_date") @db.Date
  child1Name           String?   @map("child_1_name")
  child2Name           String?   @map("child_2_name")
  child3Name           String?   @map("child_3_name")
  guardianName         String?   @map("guardian_name")
  guardianRelationship String?   @map("guardian_relationship")
  guardianNic          String?   @map("guardian_nic")
  guardianBirthDate    DateTime? @map("guardian_birth_date") @db.Date
  guardianPhone        String?   @map("guardian_phone")
  guardianAddress      String?   @map("guardian_address")
  capturedAt           DateTime  @default(now()) @map("captured_at")
  capturedViaLinkId    String?   @map("captured_via_link_id")

  candidate       Candidate          @relation(fields: [passportId], references: [passportId], onDelete: Cascade, onUpdate: Cascade)
  capturedViaLink CandidateFormLink? @relation(fields: [capturedViaLinkId], references: [linkId], onDelete: SetNull, onUpdate: Cascade)

  @@index([capturedViaLinkId])
  @@map("candidate_form_prefill_snapshot")
}

// Work Allocation (workAllocationService.js): one row per allocated
// candidate. A separate table so allocating never updates the candidate row
// (its Sheet sync trigger and updated_date). History is in audit_logs.
// Migration 20261014120000_candidate_allocation.
model CandidateAllocation {
  passportId   String   @id @map("passport_id")
  analystId    String   @map("analyst_id")
  assignedDate DateTime @default(now()) @map("assigned_date")

  candidate Candidate @relation(fields: [passportId], references: [passportId], onDelete: Cascade, onUpdate: Cascade)
  analyst   User      @relation(fields: [analystId], references: [adminId], onDelete: Restrict, onUpdate: Cascade)

  @@index([analystId])
  @@map("candidate_allocation")
}

// ---------------------------------------------------------------- Job Management
// jobService.js. Migration 20261018120000_job_management. Docs/JOB_MANAGEMENT_IMPLEMENTATION.md.
// CHECK constraints, partial unique indexes and triggers are in that
// migration's SQL (not expressible here): maintain them through a SQL migration.

// Controlled list of job types (no free text on a Job).
model JobType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobs Job[]

  @@map("job_type")
}

// The employer / customer organisation a job belongs to (formerly "company";
// migration 20261019120000_client_management). A Client works with MANY Agents
// and an Agent with many Clients (agent_client, migration
// 20261026120000_agent_client_many_to_many); a Client has many Jobs. Never
// hard-deleted: is_active = INACTIVE. A Client has no country of its own: a Job's
// To Country is its responsible Agent's country (job.country_code).
model Client {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  // DEPRECATED: the single Agent before agent_client. Not read or written by the
  // application (agentLinks is the source); kept until a later migration drops it.
  legacyAgentId  String?  @map("agent_id") @db.Uuid
  contactPerson  String?  @map("contact_person")
  contactNumber  String?  @map("contact_number")
  whatsappNumber String?  @map("whatsapp_number")
  email          String?
  address        String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  legacyAgent Agent?        @relation("ClientLegacyAgent", fields: [legacyAgentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  agentLinks  AgentClient[]
  jobs        Job[]

  @@index([legacyAgentId], map: "client_agent_id_idx")
  @@map("client")
}

// Agent <-> Client association (many-to-many). One row per pair (the primary key);
// removing a link deletes only this row (RESTRICT protects the Agent and the Client).
model AgentClient {
  agentId   String   @map("agent_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([agentId, clientId])
  @@index([clientId])
  @@map("agent_client")
}

// The agent responsible for a job; country_code (ISO 3166-1 alpha-2) is the
// agent's country and is copied onto each new job.
model Agent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  countryCode    String   @map("country_code") @db.Char(2)
  isActive       Boolean  @default(true) @map("is_active")
  contactNumber  String?  @map("contact_number")
  whatsappNumber String?  @map("whatsapp_number")
  email          String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  clientLinks   AgentClient[]
  legacyClients Client[]      @relation("ClientLegacyAgent")
  jobs          Job[]

  @@map("agent")
}

// Yearly Job Code counter: next_number is the number the NEXT job of that
// year gets. Incremented atomically (INSERT ... ON CONFLICT DO UPDATE).
model JobCodeCounter {
  year       Int @id
  nextNumber Int @map("next_number")

  @@map("job_code_counter")
}

// status: PROCESSING | COMPLETED | CANCELLED. Never hard-deleted. A COMPLETED
// or CANCELLED job cannot go back to PROCESSING (trigger; reopen is an open
// decision).
model Job {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobCode            String    @unique @map("job_code")
  // The employer's own Job ID (Y26S01): an editable attribute, never a key.
  // Unique per client when set (partial index in the SQL migration).
  companyJobId       String?   @map("company_job_id")
  jobTypeId          String    @map("job_type_id") @db.Uuid
  clientId           String    @map("client_id") @db.Uuid
  responsibleAgentId String    @map("responsible_agent_id") @db.Uuid
  // "To Country": the Client's (= its Agent's) country, copied when the job is created.
  countryCode        String    @map("country_code") @db.Char(2)
  // "From Country" (migration 20261025120000_job_from_country): RO by default for a
  // new job, editable; NULL for a job created before it was recorded.
  fromCountryCode    String?   @map("from_country_code") @db.Char(2)
  vacancies          Int?
  status             String    @default("PROCESSING")
  createdById        String    @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  completedAt        DateTime? @map("completed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelReason       String?   @map("cancel_reason")

  jobType          JobType             @relation(fields: [jobTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client           Client              @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsibleAgent Agent               @relation(fields: [responsibleAgentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy        User                @relation("JobCreatedBy", fields: [createdById], references: [adminId], onDelete: Restrict, onUpdate: Cascade)
  candidates       JobCandidate[]
  // Candidate Form job-group links bound to this job's immutable id.
  formLinks        CandidateFormLink[]

  @@index([status, createdAt])
  @@index([clientId])
  @@index([responsibleAgentId])
  @@index([jobTypeId])
  @@map("job")
}

// Candidate <-> Job membership and history. is_active = "this candidate is
// currently on this PROCESSING job": a partial unique index (passport_id WHERE
// is_active) allows at most ONE per candidate, and a trigger on job clears it
// when the job leaves PROCESSING. released_at = removed from the job by staff.
model JobCandidate {
  jobId      String    @map("job_id") @db.Uuid
  passportId String    @map("passport_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  assignedBy String    @map("assigned_by")
  isActive   Boolean   @default(true) @map("is_active")
  releasedAt DateTime? @map("released_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  job             Job       @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  candidate       Candidate @relation(fields: [passportId], references: [passportId], onDelete: Cascade, onUpdate: Cascade)
  assignedByStaff User      @relation("JobCandidateAssignedBy", fields: [assignedBy], references: [adminId], onDelete: Restrict, onUpdate: Cascade)

  @@id([jobId, passportId])
  @@index([passportId])
  @@map("job_candidate")
}

// Manual verification of a candidate's details and documents (candidateVerificationService.js).
// One row per candidate, created by the first verification. A *_at / *_by pair is set or cleared
// together (CHECKs in the migration). The Candidate list Status reads these; nothing derives them.
// Migration 20261021120000_candidate_verification.
model CandidateVerification {
  passportId            String    @id @map("passport_id")
  detailsVerifiedAt     DateTime? @map("details_verified_at")
  detailsVerifiedById   String?   @map("details_verified_by")
  documentsVerifiedAt   DateTime? @map("documents_verified_at")
  documentsVerifiedById String?   @map("documents_verified_by")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  candidate           Candidate @relation(fields: [passportId], references: [passportId], onDelete: Cascade, onUpdate: Cascade)
  detailsVerifiedBy   User?     @relation("DetailsVerifiedBy", fields: [detailsVerifiedById], references: [adminId], onDelete: Restrict, onUpdate: Cascade)
  documentsVerifiedBy User?     @relation("DocumentsVerifiedBy", fields: [documentsVerifiedById], references: [adminId], onDelete: Restrict, onUpdate: Cascade)

  @@map("candidate_verification")
}

//added document table

model Document {
  documentId         String   @id @map("document_id")
  passportId         String   @map("passport_id")
  documentType       String   @map("document_type")
  originalFilename   String   @map("original_filename")
  storedFilename     String   @map("stored_filename")
  storagePath        String   @map("storage_path")
  mimeType           String?  @map("mime_type")
  fileSize           BigInt?  @map("file_size")
  receivedDate       DateTime @map("received_date")
  processingStatus   String   @map("processing_status")
  verificationStatus String   @map("verification_status")
  ocrConfidence      Decimal? @map("ocr_confidence")
  createdDate        DateTime @default(now()) @map("created_date")
  updatedDate        DateTime @updatedAt @map("updated_date")

  user       Candidate @relation(fields: [passportId], references: [passportId])
  fileSha256 String?   @map("file_sha256") @db.Char(64)

  // Submission (temporary_data row) this file was stored from (Phase 10):
  // its processing summary and review reason explain a REVIEW_REQUIRED
  // document. Null for documents stored before this column existed.
  temporaryId   String?        @map("temporary_id")
  temporaryData TemporaryData? @relation(fields: [temporaryId], references: [temporaryId], onDelete: SetNull)

  // Police slips only (Phase 10, Checkpoint 5): the submitted date that
  // starts the 21-day wait for the final police report. Read by OCR or
  // entered by an admin when approving the slip; null otherwise.
  policeSubmittedDate DateTime? @map("police_submitted_date") @db.Date

  // Which form of the document an admin uploaded (candidateService.js):
  // police reports SL_VERIFIED / ROMANIA / SL_NORMAL, affidavits ENGLISH /
  // SINHALA. Null for every other document.
  documentVariant String? @map("document_variant")

  @@unique([passportId, fileSha256])
  @@index([fileSha256])
  @@index([temporaryId])
  @@map("documents")
}

//added temporary table

model TemporaryData {
  temporaryId          String   @id @map("temporary_id")
  passportId           String?  @map("passport_id")
  uniqueId             String?  @map("unique_id")
  whatsappNumber       String   @map("whatsapp_number")
  documentType         String   @map("document_type")
  temporaryStoragePath String   @map("temporary_storage_path")
  processingStatus     String   @map("processing_status")
  createdDate          DateTime @default(now()) @map("created_date")

  user               Candidate? @relation(fields: [passportId], references: [passportId])
  fileSha256         String?    @map("file_sha256") @db.Char(64)
  // Exact object path of the copy placed in pending/ (Phase 7), if any.
  pendingStoragePath String?    @map("pending_storage_path")

  // Phase 10 review data, written when processing finishes (or fails).
  // processing_summary: the PII-free processing summary (confidences, band,
  // flags, identity status/notes, field names, placement, failing stage).
  // review_reason: why a person must look at it (see reviewReason.js), or
  // null when no review is needed. Both null for rows processed earlier.
  processingSummary Json?      @map("processing_summary")
  reviewReason      String?    @map("review_reason")
  documents         Document[]

  // M1: asynchronous processing. The row is the durable job: the webhook
  // commits it (status TEMPORARY_STORED) before answering Meta, and the
  // background worker (submissionQueue.js) processes it.
  // message_id: the WhatsApp message ID; unique, so a redelivered message
  // never creates a second submission (also across restarts).
  messageId           String?   @unique @map("message_id")
  // As received on WhatsApp, for processing later (a file name can hold a
  // client's name, so it is never logged).
  originalFilename    String?   @map("original_filename")
  receivedAt          DateTime? @map("received_at")
  // Worker lease: claimed attempts and when the current attempt started.
  processingAttempts  Int       @default(0) @map("processing_attempts")
  processingStartedAt DateTime? @map("processing_started_at")
  // The clients/ or pending/ object path an attempt was about to create,
  // recorded before the copy: a retry after a crash reuses that object
  // instead of making a second copy (placementRecovery.js).
  placementPath       String?   @map("placement_path")

  @@index([whatsappNumber, fileSha256])
  @@index([processingStatus, createdDate])
  @@map("temporary_data")
}

// Rate-limit counters (Phase 12, Step 5C), shared by every app instance
// (several serverless instances on Vercel). Operational state only: one row
// per limiter and client, reused when its window has passed, deleted once
// expired (middleware/postgresRateLimitStore.js). key = "<limiter>:<sha256 of
// the client key>", so no IP address is stored.
// Candidate deployment stages (candidateService.js). One row per candidate
// and stage once anything is saved for it; a missing row is an incomplete
// stage without notes. Stages are independent: any can be completed in any
// order.
// Additional details of a candidate (Admin > Candidates > Additional
// Details), at most one row per candidate: passport_id is both the primary
// key and the foreign key to candidate, so a second row for the same
// candidate, or a row for a candidate that does not exist, is impossible.
// Every detail is optional (collected over time). The candidate's own
// record is never changed from here; the name, address and birthday shown
// on a new form are only suggestions from it. Values are checked by
// candidateAdditionalDetailsService.js: father / mother details are kept
// only when that parent is alive, the wife's only when married.
model CandidateAdditionalDetails {
  passportId       String    @id @map("passport_id")
  nameAsInPassport String?   @map("name_as_in_passport")
  permanentAddress String?   @map("permanent_address")
  birthday         DateTime? @db.Date
  // XS | S | M | L | XL | XXL
  tshirtSize       String?   @map("tshirt_size")
  // A preset (28 to 46) or a custom value
  pantSize         String?   @map("pant_size")
  // A preset or a custom value
  shoeSize         String?   @map("shoe_size")
  fatherAlive      Boolean?  @map("father_alive")
  fatherFullName   String?   @map("father_full_name")
  fatherBirthday   DateTime? @map("father_birthday") @db.Date
  motherAlive      Boolean?  @map("mother_alive")
  motherFullName   String?   @map("mother_full_name")
  motherBirthday   DateTime? @map("mother_birthday") @db.Date
  // SINGLE | MARRIED | DIVORCED | WIDOWED | SEPARATED
  maritalStatus    String?   @map("marital_status")
  wifeFullName     String?   @map("wife_full_name")
  wifeBirthday     DateTime? @map("wife_birthday") @db.Date
  child1Name       String?   @map("child_1_name")
  child2Name       String?   @map("child_2_name")
  child3Name       String?   @map("child_3_name")
  otherJobSkills   String?   @map("other_job_skills")
  createdDate      DateTime  @default(now()) @map("created_date")
  updatedDate      DateTime  @updatedAt @map("updated_date")

  candidate Candidate @relation(fields: [passportId], references: [passportId], onDelete: Cascade, onUpdate: Cascade)

  @@map("candidate_additional_details")
}

model CandidateStage {
  passportId     String    @map("passport_id")
  // TEST_DETAILS | JOB_DETAILS | CANDIDATE_DETAILS | DOCUMENT_SUBMISSION
  // | IVS_INTERVIEW | VISA_SUBMISSION | VISA_APPROVAL | FINALIZING_JOB
  stage          String
  completed      Boolean   @default(false)
  completedAt    DateTime? @map("completed_at")
  notes          String?
  updatedAt      DateTime  @updatedAt @map("updated_at")
  // TEST_DETAILS only (null on the other stages): the agent and the Test ID
  // the admin enters, the test's result (PASS or FAIL) and the date the
  // candidate actually sat it. Null until recorded.
  testAgentName  String?   @map("test_agent_name")
  testId         String?   @map("test_id")
  testResult     String?   @map("test_result")
  testDate       DateTime? @map("test_date") @db.Date
  // LEGACY free text, entered as "Job ID" on Test details before Job Management.
  // No longer written. Read only as the Test ID of a row that has no test_id,
  // never as a Job (the Job is the job_candidate assignment).
  jobId          String?   @map("job_id")
  // JOB_DETAILS only: the saved date. The stage's note and completion use the
  // generic notes / completed columns; its Job and Client are read from
  // job_candidate, never stored here.
  jobDetailsDate DateTime? @map("job_details_date") @db.Date

  user Candidate @relation(fields: [passportId], references: [passportId], onDelete: Cascade)

  @@id([passportId, stage])
  @@map("candidate_stages")
}

// Calls made to a candidate, noted by admins (candidateService.js).
model CandidateCallLog {
  callLogId   String   @id @map("call_log_id")
  passportId  String   @map("passport_id")
  adminId     String   @map("admin_id")
  // What the candidate said (a short note). Empty for a NO_ANSWER call.
  note        String
  // ANSWERED | NO_ANSWER (CHECK constraints in SQL, migration
  // 20261013120000_call_log_outcome: a note is required unless NO_ANSWER).
  callOutcome String   @default("ANSWERED") @map("call_outcome")
  // When the call took place: the date and time the admin entered, or now.
  createdDate DateTime @default(now()) @map("created_date")

  user  Candidate @relation(fields: [passportId], references: [passportId], onDelete: Cascade)
  admin User      @relation(fields: [adminId], references: [adminId], onDelete: Restrict)

  followUps CallLogFollowUp[]

  @@index([passportId, createdDate])
  @@map("candidate_call_logs")
}

// Priority Follow-Ups (callLogFollowUpService.js): a call log marked as
// needing attention. The call log stays the source of truth for the note,
// the call time, the caller and the candidate; this row holds only the
// follow-up's own state. status: OPEN | COMPLETED. Completing keeps the row
// (completed_by / completed_date set); Delete (ADMIN and MANAGER only)
// removes this row and never the call log.
// At most one OPEN follow-up per call log: a partial unique index (not
// expressible in Prisma's schema DSL), with CHECK constraints on status and
// completion, defined in SQL by migration 20261011120000_call_log_follow_up.
// Maintain them through a SQL migration, not this model.
model CallLogFollowUp {
  followUpId    String    @id @map("follow_up_id")
  callLogId     String    @map("call_log_id")
  status        String    @default("OPEN")
  flaggedById   String    @map("flagged_by")
  flaggedDate   DateTime  @default(now()) @map("flagged_date")
  completedById String?   @map("completed_by")
  completedDate DateTime? @map("completed_date")

  callLog     CandidateCallLog @relation(fields: [callLogId], references: [callLogId], onDelete: Cascade)
  flaggedBy   User             @relation("FollowUpFlaggedBy", fields: [flaggedById], references: [adminId], onDelete: Restrict)
  completedBy User?            @relation("FollowUpCompletedBy", fields: [completedById], references: [adminId], onDelete: Restrict)

  @@index([callLogId])
  @@index([status, flaggedDate])
  @@map("call_log_follow_up")
}

model RateLimit {
  key     String   @id
  hits    Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limits")
}

// Google Sheet operational mirror (Docs/GOOGLE_SHEET_CANDIDATE_SYNC_ARCHITECTURE.md,
// Section 8): the durable outbox. A row means "candidate <unique_id> needs to
// be mirrored", never a data snapshot (no PII): the worker re-reads the
// candidate when it processes the row. Rows are written by database triggers
// on candidate, candidate_stages and documents (migration
// 20261006120000_sheet_sync_outbox; repointed from "users" by migration
// 20261008120000_rename_candidate_user_tables), in the same transaction as
// the change.
// A partial unique index (not expressible here, defined in that migration's
// SQL) keeps at most ONE PENDING row per candidate, so changes coalesce. Do not
// add @unique on uniqueId: there may be one PENDING row plus older
// PROCESSING/COMPLETED/FAILED rows for the same candidate.
// status: PENDING | PROCESSING | COMPLETED | FAILED (dead letter).
model SheetSyncQueue {
  queueId          String    @id @default(dbgenerated("(gen_random_uuid())::text")) @map("queue_id")
  uniqueId         String    @map("unique_id")
  status           String    @default("PENDING")
  // Set when the candidate's row was deleted (or its unique ID
  // changed): only then may a missing candidate mark its row inactive.
  candidateDeleted Boolean   @default(false) @map("candidate_deleted")
  // Claims so far (incremented when claimed, so a crash counts too).
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseOwner       String?   @map("lease_owner")
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  // APPENDED | UPDATED | UNCHANGED | MARKED_INACTIVE | NOT_IN_DATABASE
  // | SUPERSEDED | RESOLVED (codes only, never values).
  lastResult       String?   @map("last_result")
  lastErrorClass   String?   @map("last_error_class")
  lastErrorCode    String?   @map("last_error_code")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([uniqueId])
  @@map("sheet_sync_queue")
}

// Durable run requests (Section 8.3): reconciliation (Sync Now, Cloud
// Scheduler) and Test Connection. The Admin API only inserts QUEUED rows; the
// sheet-sync worker claims and executes them. A partial unique index (in the
// migration's SQL) allows at most one QUEUED/RUNNING run per kind.
// kind: RECONCILE | TEST_CONNECTION; triggerSource: ADMIN | SCHEDULER | OPERATOR;
// status: QUEUED | RUNNING | SUCCEEDED | FAILED | SKIPPED.
// summary: counts and codes only, never candidate data.
model SheetSyncRun {
  runId          String    @id @map("run_id")
  kind           String
  triggerSource  String    @map("trigger_source")
  requestedBy    String?   @map("requested_by")
  status         String    @default("QUEUED")
  dryRun         Boolean?  @map("dry_run")
  attempts       Int       @default(0)
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  summary        Json?
  errorClass     String?   @map("error_class")
  errorCode      String?   @map("error_code")
  // The Sync Destination the run used (resolved when it started), or the one a
  // destination-switch check validated.
  destinationKey String?   @map("destination_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([kind, createdAt])
  @@index([status])
  @@map("sheet_sync_runs")
}

// One row ("sheet-sync", created by the migration): the integration's
// operational state as reported by the sheet-sync worker (the Admin API on
// Vercel has no Google access and reads it from here), and the writer lease
// that keeps a single process writing to the Sheet at a time.
// integrationState: UNKNOWN | OK | CONFIG_ERROR | DATA_INTEGRITY.
model SheetSyncState {
  stateId                 String    @id @map("state_id")
  integrationState        String    @default("UNKNOWN") @map("integration_state")
  lastErrorClass          String?   @map("last_error_class")
  lastErrorCode           String?   @map("last_error_code")
  lastErrorAt             DateTime? @map("last_error_at") @db.Timestamptz(3)
  lastSyncSuccessAt       DateTime? @map("last_sync_success_at") @db.Timestamptz(3)
  // ENABLED | DISABLED, as the worker last read SHEET_SYNC_ENABLED.
  writeGate               String?   @map("write_gate")
  configured              Boolean?
  // Last characters of the spreadsheet ID and the tab name: enough to tell
  // which Sheet is targeted, never the full identifier.
  targetHint              String?   @map("target_hint")
  // Sync Destination (src/config/sheetSync.js SHEET_SYNC_DESTINATIONS): the
  // configured Sheets as the worker publishes them (key, name, short hint,
  // tab name; never a full spreadsheet ID), the active one (null = the first,
  // the default) and one an ADMIN requested, active only after the worker
  // validated its access and headers.
  destinations            Json?
  activeDestinationKey    String?   @map("active_destination_key")
  requestedDestinationKey String?   @map("requested_destination_key")
  workerHeartbeatAt       DateTime? @map("worker_heartbeat_at") @db.Timestamptz(3)
  writerLeaseOwner        String?   @map("writer_lease_owner")
  writerLeaseExpiresAt    DateTime? @map("writer_lease_expires_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("sheet_sync_state")
}
