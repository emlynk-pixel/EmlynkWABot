// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//Added admin table

model Admin {
  adminId      String     @id @map("admin_id")
  name         String
  email        String     @unique
  passwordHash String?    @map("password_hash")
  role         String
  status       String     @default("ACTIVE")
  createdDate  DateTime   @default(now()) @map("created_date")
  updatedDate  DateTime   @updatedAt @map("updated_date")
  auditLogs    AuditLog[]

  @@map("admins")
}

// Review actions taken by admins (Phase 10). Append-only: rows are never
// updated or deleted (a database trigger rejects both). The reviewed item is
// kept as plain IDs, without foreign keys, so the history outlives the
// temporary_data / documents rows it describes (Remove from Review deletes
// the submission's row; its entry stays).
model AuditLog {
  auditId             String    @id @map("audit_id")
  adminId             String    @map("admin_id")
  // APPROVE | KEEP_PENDING | REMOVE_FROM_REVIEW
  // | SET_DOCUMENT_TYPE | ASSIGN_CLIENT | SET_POLICE_DATE
  action              String
  temporaryId         String?   @map("temporary_id")
  documentId          String?   @map("document_id")
  passportId          String?   @map("passport_id")
  previousStatus      String    @map("previous_status")
  newStatus           String    @map("new_status")
  reason              String?
  // Approval of a police slip: the submitted date the admin entered or confirmed.
  policeSubmittedDate DateTime? @map("police_submitted_date") @db.Date
  // Remove from Review deletes the submission's row, so the entry keeps
  // what was removed: its document type and file checksum.
  documentType        String?   @map("document_type")
  fileSha256          String?   @map("file_sha256") @db.Char(64)
  // Corrections: the value before and after (document type, passport ID
  // or police slip date as YYYY-MM-DD). Null for the other actions.
  previousValue       String?   @map("previous_value")
  newValue            String?   @map("new_value")
  createdDate         DateTime  @default(now()) @map("created_date")

  admin Admin @relation(fields: [adminId], references: [adminId], onDelete: Restrict)

  @@index([temporaryId, createdDate])
  @@index([documentId, createdDate])
  @@index([adminId, createdDate])
  @@map("audit_logs")
}

//added user table

model User {
  passportId         String          @id @map("passport_id")
  uniqueId           String          @unique @map("unique_id")
  firstName          String          @map("first_name")
  otherName          String?         @map("other_name")
  dateOfBirth        DateTime?       @map("date_of_birth")
  placeOfBirth       String?         @map("place_of_birth")
  passportExpiryDate DateTime?       @map("passport_expiry_date")
  picture            String?
  whatsappNumber     String?         @map("whatsapp_number")
  contactNumber      String?         @map("contact_number")
  address            String?
  job                String?
  createdDate        DateTime        @default(now()) @map("created_date")
  updatedDate        DateTime        @updatedAt @map("updated_date")
  documents          Document[]
  temporaryData      TemporaryData[]

  @@map("users")
}

//added document table

model Document {
  documentId         String   @id @map("document_id")
  passportId         String   @map("passport_id")
  documentType       String   @map("document_type")
  originalFilename   String   @map("original_filename")
  storedFilename     String   @map("stored_filename")
  storagePath        String   @map("storage_path")
  mimeType           String?  @map("mime_type")
  fileSize           BigInt?  @map("file_size")
  receivedDate       DateTime @map("received_date")
  processingStatus   String   @map("processing_status")
  verificationStatus String   @map("verification_status")
  ocrConfidence      Decimal? @map("ocr_confidence")
  createdDate        DateTime @default(now()) @map("created_date")
  updatedDate        DateTime @updatedAt @map("updated_date")

  user       User    @relation(fields: [passportId], references: [passportId])
  fileSha256 String? @map("file_sha256") @db.Char(64)

  // Submission (temporary_data row) this file was stored from (Phase 10):
  // its processing summary and review reason explain a REVIEW_REQUIRED
  // document. Null for documents stored before this column existed.
  temporaryId   String?        @map("temporary_id")
  temporaryData TemporaryData? @relation(fields: [temporaryId], references: [temporaryId], onDelete: SetNull)

  // Police slips only (Phase 10, Checkpoint 5): the submitted date that
  // starts the 21-day wait for the final police report. Read by OCR or
  // entered by an admin when approving the slip; null otherwise.
  policeSubmittedDate DateTime? @map("police_submitted_date") @db.Date

  @@unique([passportId, fileSha256])
  @@index([fileSha256])
  @@index([temporaryId])
  @@map("documents")
}

//added temporary table

model TemporaryData {
  temporaryId          String   @id @map("temporary_id")
  passportId           String?  @map("passport_id")
  uniqueId             String?  @map("unique_id")
  whatsappNumber       String   @map("whatsapp_number")
  documentType         String   @map("document_type")
  temporaryStoragePath String   @map("temporary_storage_path")
  processingStatus     String   @map("processing_status")
  createdDate          DateTime @default(now()) @map("created_date")

  user               User?   @relation(fields: [passportId], references: [passportId])
  fileSha256         String? @map("file_sha256") @db.Char(64)
  // Exact object path of the copy placed in pending/ (Phase 7), if any.
  pendingStoragePath String? @map("pending_storage_path")

  // Phase 10 review data, written when processing finishes (or fails).
  // processing_summary: the PII-free processing summary (confidences, band,
  // flags, identity status/notes, field names, placement, failing stage).
  // review_reason: why a person must look at it (see reviewReason.js), or
  // null when no review is needed. Both null for rows processed earlier.
  processingSummary Json?      @map("processing_summary")
  reviewReason      String?    @map("review_reason")
  documents         Document[]

  @@index([whatsappNumber, fileSha256])
  @@map("temporary_data")
}
